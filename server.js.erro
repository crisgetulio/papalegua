// ===== SISTEMA DE CHAVES (Signal Protocol Simples) =====

// Gerar chave pública/privada
function generateKeyPair() {
    const privateKey = CryptoJS.lib.WordArray.random(32).toString();
    const publicKey = CryptoJS.SHA256(privateKey).toString();
    return { publicKey, privateKey };
}

// Criptografar mensagem com chave pública do destinatário
function encryptMessage(text, publicKey) {
    return CryptoJS.AES.encrypt(text, publicKey).toString();
}

// Descriptografar com chave privada
function decryptMessage(encrypted, privateKey) {
    try {
        const bytes = CryptoJS.AES.decrypt(encrypted, privateKey);
        return bytes.toString(CryptoJS.enc.Utf8);
    } catch(e) {
        return null;
    }
}

// Gerar ID onion (anonimato)
function generateOnionId() {
    return CryptoJS.lib.WordArray.random(16).toString();
}

// Número de segurança (verificação)
function getSecurityNumber(publicKey) {
    const hash = CryptoJS.SHA256(publicKey).toString().toUpperCase();
    return hash.slice(0, 12);
}

