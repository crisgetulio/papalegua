app.post('/api/admin/version', requireAuth, (req, res) => {
    if (!isAdmin(req.session.userId)) {
        return res.status(403).json({ error: 'Apenas o administrador pode gerenciar versões' });
    }
    const { version, versionCode, releaseNotes, forced } = req.body;
    if (!version || !versionCode) {
