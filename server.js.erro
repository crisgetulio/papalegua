// ===== SISTEMA DE CHAVES (Signal Protocol Simples) =====

// Gerar par de chaves para novo usuário
function generateKeyPair() {
    const privateKey = CryptoJS.lib.WordArray.random(32).toString();
    const publicKey = CryptoJS.SHA256(privateKey).toString();
    return { publicKey, privateKey };
}

// Gerar ID onion (identificador anônimo)
function generateOnionId() {
    return CryptoJS.lib.WordArray.random(16).toString();
}

// Criptografar mensagem com chave pública do destinatário
function encryptMessage(text, publicKey) {
    try {
        return CryptoJS.AES.encrypt(text, publicKey).toString();
    } catch(e) {
        return null;
    }
}

// Descriptografar mensagem com chave privada
function decryptMessage(encrypted, privateKey) {
    try {
        const bytes = CryptoJS.AES.decrypt(encrypted, privateKey);
        return bytes.toString(CryptoJS.enc.Utf8);
    } catch(e) {
        return null;
    }
}

// Gerar número de segurança (para verificação)
function getSecurityNumber(publicKey) {
    const hash = CryptoJS.SHA256(publicKey).toString(CryptoJS.enc.Hex).toUpperCase();
    // Formatar como grupos de 4 dígitos: A3F8 9C2D 1E4B 7H6G
    const groups = hash.match(/.{1,4}/g) || [];
    return groups.slice(0, 4).join(' ');
}

// ===== ADICIONAR CHAVES NO REGISTRO =====
// Modificar a rota /api/register para gerar chaves
// Esta é uma sobrescrita - a rota original já existe, vamos adicionar a lógica
const originalRegister = app.post.bind(app);
app.post = function(path, ...handlers) {
    if (path === '/api/register') {
        // Envolver o handler original para adicionar chaves
        const originalHandler = handlers[0];
        const newHandler = async (req, res) => {
            try {
                // Chamar o handler original (que já existe no código)
                // Mas como estamos sobrescrevendo, vamos executar nossa versão
                let { username, email, phone, address, password } = req.body;
                username = (username || '').trim();
                email = (email || '').trim().toLowerCase();
                phone = (phone || '').trim();
                address = (address || '').trim();
                password = (password || '').trim();

                if (!username || !email || !password) {
                    return res.status(400).json({ error: 'Campos obrigatórios' });
                }
                if (username.length < 3) {
                    return res.status(400).json({ error: 'Usuário deve ter ao menos 3 caracteres' });
                }
                if (password.length < 6) {
                    return res.status(400).json({ error: 'Senha deve ter ao menos 6 caracteres' });
                }

                const hash = await bcrypt.hash(password, 10);
                
                // Gerar chaves e ID onion
                const { publicKey, privateKey } = generateKeyPair();
                const onionId = generateOnionId();
                const securityNumber = getSecurityNumber(publicKey);

                db.prepare(`
                    INSERT INTO users 
                    (username, email, phone, address, password_hash, public_key, private_key, onion_id, security_number) 
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
                `).run(
                    username, email, phone, address, hash,
                    publicKey, privateKey, onionId, securityNumber
                );

                res.json({ 
                    success: true, 
                    user: { username, email, publicKey, onionId, securityNumber }
                });
            } catch(e) {
                if (e.message.includes('UNIQUE')) {
                    if (e.message.includes('username')) {
                        return res.status(400).json({ error: 'Nome de usuário já em uso' });
                    }
                    if (e.message.includes('email')) {
                        return res.status(400).json({ error: 'E-mail já cadastrado' });
                    }
                    if (e.message.includes('onion_id')) {
                        return res.status(400).json({ error: 'Erro ao gerar ID anônimo' });
                    }
                }
                res.status(400).json({ error: e.message });
            }
        };
        // Aplicar a nova função
        app._router.route(path).post(newHandler);
        return;
    }
    // Para outras rotas, usar o comportamento padrão
    app._router.route(path)[handlers.length > 1 ? 'post' : 'get'](handlers[0]);
};

