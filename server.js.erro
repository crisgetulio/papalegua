// Rota para verificar segurança (números)
app.get('/api/user/:id/security-number', requireAuth, (req, res) => {
    const userId = parseInt(req.params.id);
    if (isNaN(userId)) return res.status(400).json({ error: 'ID inválido' });
    const user = db.prepare(`SELECT public_key FROM users WHERE id = ?`).get(userId);
    if (!user) return res.status(404).json({ error: 'Usuário não encontrado' });
    
    // Gerar número de segurança (primeiros 12 caracteres do hash da chave pública)
    const hash = crypto.createHash('sha256').update(user.public_key).digest('hex').toUpperCase();
    const securityNumber = hash.slice(0, 12).replace(/(.{4})/g, '$1 ').trim();
    res.json({ securityNumber });
});

// Criptografar mensagem (rota auxiliar)
app.post('/api/encrypt', requireAuth, (req, res) => {
    const { text, publicKey } = req.body;
    if (!text || !publicKey) return res.status(400).json({ error: 'text e publicKey obrigatórios' });
    
    const encrypted = crypto.publicEncrypt(publicKey, Buffer.from(text));
    res.json({ encrypted: encrypted.toString('base64') });
});

// Descriptografar mensagem (rota auxiliar)
app.post('/api/decrypt', requireAuth, (req, res) => {
    const { encrypted, privateKey } = req.body;
    if (!encrypted || !privateKey) return res.status(400).json({ error: 'encrypted e privateKey obrigatórios' });
    
    try {
        const decrypted = crypto.privateDecrypt(privateKey, Buffer.from(encrypted, 'base64'));
        res.json({ decrypted: decrypted.toString('utf8') });
    } catch(e) {
        res.status(400).json({ error: 'Erro ao descriptografar' });
    }
});

