// Rotas para mensagens autodestrutivas
app.post('/api/private-message-with-timer', requireAuth, (req, res) => {
    const { toUserId, text, type, timer, replyToId, replyToText, replyToSender } = req.body;
    if (!toUserId) return res.status(400).json({ error: 'toUserId obrigatório' });
    
    const fromUserId = req.session.userId;
    const fromUser = db.prepare('SELECT username, avatar_url, public_key FROM users WHERE id = ?').get(fromUserId);
    const toUser = db.prepare('SELECT public_key FROM users WHERE id = ?').get(toUserId);
    
    // Criptografar a mensagem com a chave pública do destinatário
    let encryptedText = text;
    if (toUser && toUser.public_key) {
        encryptedText = crypto.AES.encrypt(text, toUser.public_key).toString();
    }
    
    const expiresAt = timer && timer > 0 ? Date.now() + (timer * 1000) : null;
    
    const stmt = db.prepare(`
        INSERT INTO private_messages 
        (from_user_id, to_user_id, text, type, url, audio_url, name, size, 
         reply_to_id, reply_to_text, reply_to_sender, timestamp, expires_at)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `);
    
    const info = stmt.run(
        fromUserId, parseInt(toUserId), encryptedText, type || 'text',
        null, null, null, null,
        replyToId || null, replyToText || null, replyToSender || null,
        new Date().toISOString(), expiresAt
    );
    
    const newMsg = {
        id: info.lastInsertRowid,
        from_user_id: fromUserId,
        to_user_id: parseInt(toUserId),
        text: text, // texto original (só para o remetente)
        type: type || 'text',
        timestamp: new Date().toISOString(),
        fromUsername: fromUser.username,
        fromAvatar: fromUser.avatar_url,
        edited: 0,
        read: false,
        expiresAt: expiresAt
    };
    
    // Enviar via Socket.IO
    io.to(`user_${toUserId}`).emit('private message', newMsg);
    io.to(`user_${fromUserId}`).emit('private message', newMsg);
    
    res.json({ success: true, message: newMsg });
});

// Rota para limpar mensagens expiradas (executar periodicamente)
app.post('/api/clean-expired-messages', requireAuth, (req, res) => {
    const now = Date.now();
    const deleted = db.prepare('DELETE FROM private_messages WHERE expires_at IS NOT NULL AND expires_at < ?').run(now);
    res.json({ deleted: deleted.changes });
});

// Rota para atualizar o ID onion (se o usuário quiser mudar)
app.post('/api/regenerate-onion-id', requireAuth, (req, res) => {
    const userId = req.session.userId;
    const newOnionId = crypto.lib.WordArray.random(16).toString();
    db.prepare('UPDATE users SET onion_id = ? WHERE id = ?').run(newOnionId, userId);
    res.json({ onionId: newOnionId });
});

// ===== SISTEMA DE CRIPTOGRAFIA =====

// Gerar par de chaves (pública/privada)
function generateKeyPair() {
    // Gerar chave privada aleatória (256 bits)
    const privateKey = CryptoJS.lib.WordArray.random(32).toString();
    // Chave pública = SHA256 da privada (simplificado)
    const publicKey = CryptoJS.SHA256(privateKey).toString();
    return { publicKey, privateKey };
}

// Criptografar mensagem com chave pública do destinatário
function encryptMessage(text, publicKey) {
    try {
        return CryptoJS.AES.encrypt(text, publicKey).toString();
    } catch(e) {
        console.error('Erro ao criptografar:', e);
        return null;
    }
}

// Descriptografar com chave privada
function decryptMessage(encrypted, privateKey) {
    try {
        const bytes = CryptoJS.AES.decrypt(encrypted, privateKey);
        return bytes.toString(CryptoJS.enc.Utf8);
    } catch(e) {
        console.error('Erro ao descriptografar:', e);
        return null;
    }
}

// Gerar ID Onion (anonimato)
function generateOnionId() {
    return CryptoJS.lib.WordArray.random(16).toString();
}

// Número de segurança (para verificação)
function getSecurityNumber(publicKey) {
    const hash = CryptoJS.SHA256(publicKey).toString().toUpperCase();
    return hash.slice(0, 12);
}

// Verificar se mensagem expirou
function isMessageExpired(expiresAt) {
    if (!expiresAt || expiresAt === 0) return false;
    return Date.now() > expiresAt;
}
