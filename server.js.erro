// ===== SOBRESCREVER O ENVIO DE MENSAGENS PARA CRIPTOGRAFAR =====
// Guardar o handler original do Socket.IO
const originalPrivateMessageHandler = io._events['connection']?._events?.['private message'];

// Adicionar criptografia no socket 'private message'
// Como já temos a implementação, vamos modificar o comportamento
// Vamos adicionar um middleware no Socket.IO
io.use((socket, next) => {
    // Adicionar função de criptografia ao socket
    socket.encryptMessage = encryptMessage;
    socket.decryptMessage = decryptMessage;
    next();
});

// Nota: A lógica de criptografia será aplicada no frontend (private-chat.html)
// O servidor apenas armazena as chaves e fornece a chave pública dos usuários

// ===== MENSAGENS AUTODESTRUTIVAS =====
// Adicionar campo expires_at na tabela
try {
    db.exec(`ALTER TABLE private_messages ADD COLUMN expires_at INTEGER`);
} catch(e) { /* coluna já existe */ }

// Modificar o handler de mensagens para suportar timer
// O código já existe, apenas garantir que o timer seja salvo
// A lógica de expiração será feita no frontend
// E no backend, ao enviar, salvar o expires_at

// Rota para remover mensagens expiradas (chamada pelo frontend)
app.post('/api/messages/expire', requireAuth, (req, res) => {
    const { messageIds } = req.body;
    if (!messageIds || !Array.isArray(messageIds)) {
        return res.status(400).json({ error: 'messageIds é obrigatório' });
    }
    
    const userId = req.session.userId;
    const placeholders = messageIds.map(() => '?').join(',');
    
    // Verificar se o usuário é o remetente ou destinatário
    const stmt = db.prepare(`
        DELETE FROM private_messages 
        WHERE id IN (${placeholders}) 
        AND (from_user_id = ? OR to_user_id = ?)
    `);
    
    const params = [...messageIds, userId, userId];
    const result = stmt.run(...params);
    
    // Notificar os usuários sobre a remoção
    messageIds.forEach(id => {
        io.emit('message expired', { messageId: id });
    });
    
    res.json({ success: true, removed: result.changes });
});

