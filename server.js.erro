    }
    const data = {
        version: version,
        versionCode: parseInt(versionCode),
        apkUrl: versionInfo?.apkUrl || '',
        releaseNotes: releaseNotes || '',
        forced: forced || false,
        updatedAt: new Date().toISOString()
    };
    saveVersion(data);
    io.emit('new version', { 
        version: data.version, 
        versionCode: data.versionCode,
        releaseNotes: data.releaseNotes,
        forced: data.forced,
        apkUrl: data.apkUrl
    });
