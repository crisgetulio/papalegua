                    path: 'uploads/ (público)',
                    type: 'public',
                    isDirectory: stat.isDirectory()
                });
            });
        }
        
        // 2. Arquivos da pasta PRIVATE_UPLOADS_DIR (privada) - /opt/papalegua-backend/private_uploads/
        if (fs.existsSync(PRIVATE_UPLOADS_DIR)) {
