// ===== ROTAS PARA GERENCIAMENTO DE ARQUIVOS (APENAS ADMIN) =====
app.get('/api/files', requireAuth, (req, res) => {
    const adminUser = db.prepare(`SELECT id FROM users ORDER BY id ASC LIMIT 1`).get();
    if (!adminUser || adminUser.id !== req.session.userId) {
        return res.status(403).json({ error: 'Acesso negado' });
    }
    
    try {
        let allFiles = [];
        
        if (fs.existsSync(UPLOAD_DIR)) {
            const items = fs.readdirSync(UPLOAD_DIR);
            items.forEach(file => {
                const filePath = path.join(UPLOAD_DIR, file);
                const stat = fs.statSync(filePath);
                if (stat.isDirectory()) {
                    if (file === 'avatars' || file === 'apk') return;
                }
                if (file === 'default.png' || file === 'default.svg') return;
                
                allFiles.push({
                    name: file,
                    size: stat.size,
                    uploadedAt: stat.mtime,
                    path: 'uploads/ (público)',
                    type: 'public'
                });
            });
        }
        
        if (fs.existsSync(PRIVATE_UPLOADS_DIR)) {
            const items = fs.readdirSync(PRIVATE_UPLOADS_DIR);
            items.forEach(file => {
                const filePath = path.join(PRIVATE_UPLOADS_DIR, file);
                const stat = fs.statSync(filePath);
                if (stat.isDirectory()) return;
                
                allFiles.push({
                    name: file,
                    size: stat.size,
                    uploadedAt: stat.mtime,
                    path: 'private_uploads/ (privado)',
                    type: 'private'
                });
            });
        }
        
        res.json({ files: allFiles });
    } catch(e) {
        res.status(500).json({ error: e.message });
    }
});

app.post('/api/file/delete', requireAuth, (req, res) => {
    const adminUser = db.prepare(`SELECT id FROM users ORDER BY id ASC LIMIT 1`).get();
    if (!adminUser || adminUser.id !== req.session.userId) {
        return res.status(403).json({ error: 'Acesso negado' });
    }
    
    const { filename, type } = req.body;
    if (!filename) return res.status(400).json({ error: 'filename obrigatório' });
    
    const baseDir = type === 'private' ? PRIVATE_UPLOADS_DIR : UPLOAD_DIR;
    const filepath = path.join(baseDir, filename);
    
    if (!fs.existsSync(filepath)) {
        return res.status(404).json({ error: 'Arquivo não encontrado' });
    }
    
    try {
        fs.unlinkSync(filepath);
        res.json({ success: true });
    } catch(e) {
        res.status(500).json({ error: e.message });
    }
});

app.post('/api/file/rename', requireAuth, (req, res) => {
    const adminUser = db.prepare(`SELECT id FROM users ORDER BY id ASC LIMIT 1`).get();
    if (!adminUser || adminUser.id !== req.session.userId) {
        return res.status(403).json({ error: 'Acesso negado' });
    }
    
    const { oldName, newName, type } = req.body;
    if (!oldName || !newName) {
        return res.status(400).json({ error: 'oldName e newName obrigatórios' });
    }
    
    const baseDir = type === 'private' ? PRIVATE_UPLOADS_DIR : UPLOAD_DIR;
    const oldPath = path.join(baseDir, oldName);
    const newPath = path.join(baseDir, newName);
    
    if (!fs.existsSync(oldPath)) {
        return res.status(404).json({ error: 'Arquivo não encontrado' });
    }
    
    if (fs.existsSync(newPath)) {
        return res.status(400).json({ error: 'Já existe um arquivo com este nome' });
    }
    
    try {
        fs.renameSync(oldPath, newPath);
        res.json({ success: true });
    } catch(e) {
        res.status(500).json({ error: e.message });
    }
});
